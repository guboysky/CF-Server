{
  "name": "Huilang 终端主题",
  "short": "huilang",
  "description": "参考 CF-Server-Monitor 的终端风格，支持条形、环形、列表、地图和历史图表",
  "version": "1.0.13",
  "author": "guboysky",
  "url": "https://github.com/guboysky/CF-Server",
  "config": [
    {
      "key": "notice",
      "type": "text",
      "label": "首页公告",
      "default": ""
    },
    {
      "key": "background_url",
      "type": "string",
      "label": "背景图片 URL",
      "default": "https://cdn.nodeimage.com/i/cqQOJLlYo0Vb5PvfIvJjEu34NNcwbhZY.webp",
      "help": "默认使用参考演示站同款背景；清空可关闭，也可填写自己的图片地址"
    },
    {
      "key": "panel_opacity",
      "type": "number",
      "label": "面板不透明度",
      "default": 0.72,
      "min": 0.3,
      "max": 1
    },
    {
      "key": "layout",
      "type": "select",
      "label": "默认视图",
      "default": "bar",
      "options": [
        {
          "value": "bar",
          "label": "条形图"
        },
        {
          "value": "ring",
          "label": "环形图"
        },
        {
          "value": "list",
          "label": "列表"
        },
        {
          "value": "map",
          "label": "地图"
        }
      ]
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示汇总",
      "default": true
    },
    {
      "key": "show_price",
      "type": "boolean",
      "label": "卡片显示价格",
      "default": true
    },
    {
      "key": "show_latency",
      "type": "boolean",
      "label": "卡片显示延迟记录",
      "default": true,
      "help": "可见卡片每分钟更新；最多两个历史查询并行"
    }
  ]
}
